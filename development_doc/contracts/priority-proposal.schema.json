{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/contracts/priority-proposal.schema.json",
  "title": "PriorityProposal",
  "description": "A validated, non-executable AI recommendation bound to one job revision, approved policy, candidate summary, and adapter configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "request_id",
    "subject_id",
    "job_id",
    "job_revision",
    "job_content_hash",
    "policy_id",
    "policy_version",
    "policy_content_hash",
    "candidate_summary_version",
    "candidate_summary_content_hash",
    "agent_version",
    "prompt_version",
    "model_id",
    "created_at",
    "proposed_qualification",
    "proposed_priority_level",
    "confidence",
    "summary",
    "positive_signals",
    "concerns",
    "hard_constraint_findings",
    "eligibility_findings",
    "missing_information",
    "questions_for_user"
  ],
  "properties": {
    "proposal_id": {
      "$ref": "#/$defs/id"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "subject_id": {
      "$ref": "#/$defs/id"
    },
    "job_id": {
      "$ref": "#/$defs/id"
    },
    "job_revision": {
      "type": "integer",
      "minimum": 1
    },
    "job_content_hash": {
      "$ref": "#/$defs/hash"
    },
    "policy_id": {
      "$ref": "#/$defs/id"
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_content_hash": {
      "$ref": "#/$defs/hash"
    },
    "candidate_summary_version": {
      "$ref": "#/$defs/id"
    },
    "candidate_summary_content_hash": {
      "$ref": "#/$defs/hash"
    },
    "agent_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "model_id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposed_qualification": {
      "type": "string",
      "enum": [
        "QUALIFIED",
        "EXCLUDED",
        "NEEDS_USER"
      ]
    },
    "proposed_priority_level": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        null
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "positive_signals": {
      "$ref": "#/$defs/rationales"
    },
    "concerns": {
      "$ref": "#/$defs/rationales"
    },
    "hard_constraint_findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/hardConstraintFinding"
      }
    },
    "eligibility_findings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/eligibilityFinding"
      }
    },
    "missing_information": {
      "$ref": "#/$defs/textList"
    },
    "questions_for_user": {
      "$ref": "#/$defs/textList"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "textList": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_id",
        "field",
        "excerpt"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "JOB_FIELD",
            "JOB_DESCRIPTION",
            "POLICY_HARD_CONSTRAINT",
            "POLICY_SOFT_PREFERENCE",
            "CANDIDATE_FACT",
            "DETERMINISTIC_FACT"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "category",
        "explanation",
        "evidence_refs"
      ],
      "properties": {
        "signal_id": {
          "$ref": "#/$defs/id"
        },
        "category": {
          "type": "string",
          "enum": [
            "ROLE",
            "DOMAIN",
            "LOCATION",
            "COMPANY",
            "FRESHNESS",
            "SENIORITY",
            "WORK_MODE",
            "CANDIDATE_FIT",
            "APPLICATION_EFFORT",
            "OTHER"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "rationales": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/rationale"
      }
    },
    "hardConstraintFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "result",
        "explanation",
        "evidence_refs"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/id"
        },
        "result": {
          "type": "string",
          "enum": [
            "MATCHED",
            "NOT_MATCHED",
            "UNKNOWN"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    },
    "eligibilityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "result",
        "impact",
        "explanation",
        "evidence_refs"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "WORK_AUTHORIZATION",
            "CITIZENSHIP_OR_RESIDENCY",
            "STUDENT_STATUS",
            "SECURITY_CLEARANCE"
          ]
        },
        "result": {
          "type": "string",
          "enum": [
            "SATISFIED",
            "NOT_SATISFIED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "impact": {
          "type": "string",
          "enum": [
            "NONE",
            "LOWER_PRIORITY",
            "NEEDS_USER",
            "EXCLUDED_BY_APPROVED_POLICY"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "proposed_qualification": {
            "const": "QUALIFIED"
          }
        },
        "required": [
          "proposed_qualification"
        ]
      },
      "then": {
        "properties": {
          "proposed_priority_level": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "positive_signals": {
            "minItems": 1
          },
          "hard_constraint_findings": {
            "not": {
              "contains": {
                "properties": {
                  "result": {
                    "const": "MATCHED"
                  }
                },
                "required": [
                  "result"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposed_qualification": {
            "const": "EXCLUDED"
          }
        },
        "required": [
          "proposed_qualification"
        ]
      },
      "then": {
        "properties": {
          "proposed_priority_level": {
            "const": null
          },
          "hard_constraint_findings": {
            "contains": {
              "properties": {
                "result": {
                  "const": "MATCHED"
                }
              },
              "required": [
                "result"
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "proposed_qualification": {
            "const": "NEEDS_USER"
          }
        },
        "required": [
          "proposed_qualification"
        ]
      },
      "then": {
        "properties": {
          "proposed_priority_level": {
            "const": null
          }
        },
        "anyOf": [
          {
            "properties": {
              "missing_information": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "questions_for_user": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  ]
}
