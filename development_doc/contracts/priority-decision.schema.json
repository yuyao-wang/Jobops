{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobops.local/contracts/priority-decision.schema.json",
  "title": "PriorityDecision",
  "description": "A deterministic, explainable priority result bound to immutable job and candidate inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "job_id",
    "job_content_hash",
    "candidate_snapshot_version",
    "scoring_version",
    "qualification",
    "match_score",
    "match_breakdown",
    "freshness_score",
    "priority_score",
    "priority_level",
    "hard_filters",
    "reasons",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "job_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_snapshot_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scoring_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "qualification": {
      "type": "string",
      "enum": [
        "QUALIFIED",
        "EXCLUDED",
        "NEEDS_USER"
      ]
    },
    "match_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "match_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factor",
          "score",
          "weight",
          "reason"
        ],
        "properties": {
          "factor": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "freshness_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "priority_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "priority_level": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        null
      ]
    },
    "hard_filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASSED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qualification": {
            "const": "QUALIFIED"
          }
        },
        "required": [
          "qualification"
        ]
      },
      "then": {
        "properties": {
          "match_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "match_breakdown": {
            "type": "array",
            "minItems": 1
          },
          "freshness_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "priority_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "priority_level": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "priority_level": {
            "type": "null"
          }
        }
      }
    }
  ]
}
