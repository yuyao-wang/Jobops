# Legacy compatibility example only. Production Jobops reads verified facts and
# answers from its repository-external Private Home. Every answer below is
# intentionally empty: confirm it in the private vault before any application.
personal:
  first_name: Your
  last_name: Name
  email: you@example.com
  phone: +1-555-000-0000
  location: San Francisco, CA
  linkedin: https://linkedin.com/in/yourprofile
  github: https://github.com/yourusername
  portfolio: https://yoursite.com
resume_path: ./resume.pdf
preferences:
  roles:
  - Software Engineer
  - Backend Engineer
  - Full Stack Engineer
  - Platform Engineer
  keywords:
  - Python
  - Rust
  - distributed systems
  - AI
  min_match_score: 65
  remote_only: false
  locations:
  - San Francisco
  - Remote
  exclude_companies:
  - ExampleBadCorp
common_answers:
  authorized_to_work: ''
  require_sponsorship: ''
  years_experience: ''
  willing_to_relocate: ''
  salary_expectation: ''
  earliest_start_date: ''
  how_did_you_hear: ''
  gender: ''
  race_ethnicity: ''
  veteran_status: ''
  disability_status: ''
target_boards:
  greenhouse:
  - anthropic
  - stripe
  - figma
  - vercel
  - datadog
  lever:
  - anyscale
search:
  enabled: true
  queries:
  - Software Engineer
  - Backend Engineer
  locations:
  - San Francisco, CA
  - Remote
  distance_miles: 50
  results_per_query: 25
  salary_min: 0
skills:
  primary:
  - Python
  - Rust
  - Go
  - distributed systems
  secondary:
  - Kubernetes
  - Docker
  - AWS
  - PostgreSQL
  - React
ideal_job_description: 'A senior backend or platform engineering role at a technology
  company building distributed systems, developer tools, or AI infrastructure. Strong
  engineering culture, remote-friendly, competitive compensation.'
favorite_companies:
- anthropic
- stripe
- figma
- vercel
custom_career_pages: []
rate_limits:
  max_applications_per_day: 25
  min_delay_seconds: 60
  max_delay_seconds: 180

# Safari is the preferred browser for user handoff. Automated form filling uses
# persistent Chromium because Playwright cannot reuse Safari cookies.
browser:
  preferred_handoff_browser: safari
  chromium_user_data_dir: ~/Library/Application Support/Jobops/browser/chromium
  slow_mo_ms: 100

# Workday passwords are stored in macOS Keychain under a tenant-specific
# jobops.workday.* service (legacy mr-jobs.workday.* entries are migrated);
# never put a password in this file.
workday:
  auto_login: true
  auto_register: true
  generated_password_length: 24
schedule:
  discover_interval_hours: 6
  score_interval_minutes: 30
  enabled: true
email:
  enabled: false
  imap_server: imap.gmail.com
  email: ''
  # Store the secret in Keychain under this service and the email as account.
  keychain_service: jobops.mailbox.imap.imap.gmail.com
  check_interval_hours: 12

# AI Backend Configuration (optional — Jobops defaults trusted work to local Codex)
# ATS/mailbox passwords and the permit HMAC key stay in macOS Keychain. Optional
# AI-provider API tokens are read from runtime environment variables only; they
# are never persisted in this file or Private Home.
# Each component can independently use a different LLM backend.
ai:
  default_backend: codex_cli
  backends:
    codex_cli:
      # Uses the locally authenticated Codex CLI. Omit model to use Codex config.
      timeout: 180
      # M1b activates this profile only after its no-generation host, login,
      # strict-schema, image, and tool-isolation probe succeeds. Unsupported
      # hosts fail closed; raw Codex remains available for trusted work.
      isolation_profile: isolated_subscription_cli_v1
    openai_api:
      # Export OPENAI_API_KEY instead of storing the secret in this file.
      # Literal API keys are rejected; ${OPENAI_API_KEY} is also accepted.
      api_key_env: OPENAI_API_KEY
      model: gpt-5.4-mini
      base_url: https://api.openai.com/v1
      timeout: 120
      reasoning_effort: low
      store: false
    gemini:
      api_key: ${GEMINI_API_KEY}
      model: gemini-2.5-flash
      timeout: 60
    # ollama:
    #   base_url: http://localhost:11434
    #   model: llama3
    #   timeout: 120
  components:
    scoring: codex_cli
    # Subscription-first Preparation path. Each component is resolved against
    # the effective M1b capabilities; there is no fallback to an API backend.
    resume_selection: codex_cli
    resume_tailoring: codex_cli
    resume_fact_qa: codex_cli
    base_latex_selection: codex_cli
    resume_latex_construction: codex_cli
    resume_visual_qa: codex_cli
    resume_layout_revision: codex_cli
    cover_letter: codex_cli
    cover_letter_fact_qa: codex_cli
    # Required only when --semantic-mapper handles untrusted browser labels.
    # In a local-Codex-only setup, omit --semantic-mapper and hand off unknowns.
    form_analysis: openai_api
    email_classification: openai_api
    profile_analysis: codex_cli
    # Direct API mappings remain optional. The current OpenAI wrapper is
    # text-only, so it cannot serve resume_visual_qa.
